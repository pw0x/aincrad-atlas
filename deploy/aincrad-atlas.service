[Unit]
Description=Aincrad Atlas release version and archived scene evidence
After=network-online.target

[Service]
User=aincrad-api
Group=aincrad-api
WorkingDirectory=/srv/aincrad-atlas/current
Environment=ATLAS_STATE_DIR=/var/lib/aincrad-atlas
EnvironmentFile=-/etc/aincrad-atlas/api.env
EnvironmentFile=/srv/aincrad-atlas/current/revision.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /srv/aincrad-atlas/current/server/atlas.py serve
Restart=on-failure
RestartSec=2
StateDirectory=aincrad-atlas
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
